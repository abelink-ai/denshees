# Environment variables for deploying Denshees with Docker Compose / Dokploy.
# When deploying via Dokploy's template (blueprints/denshees/template.toml),
# the required secrets and domain URLs are generated automatically.

# --- Database (bundled PostgreSQL) ---
POSTGRES_USER=denshees
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=denshees

# --- Public App URL ---
# Set to your Dokploy domain (used for payment redirects and email open tracking)
APP_URL=https://denshees.example.com
TRACKING_BASE_URL=https://denshees.example.com

# --- Core Auth & Internal Secrets ---
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-32-byte-secret
API_KEY=change-me-to-a-random-api-key

# --- AI Features (OpenAI) ---
OPENAI_API_KEY=

# --- Optional: Google Sign-In ---
# Set the same Web OAuth 2.0 Client ID in both variables (NEXT_PUBLIC_ is baked at build time)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Optional: Payments (Dodo Payments) ---
DODO_PAYMENTS_API_KEY=

# --- Optional: Support Notification Email (SMTP) ---
SMTP_USER=
SMTP_PASS=
SUPPORT_NOTIFY_EMAILS=

# --- Optional: Analytics & Tracing ---
NEXT_PUBLIC_AMPLITUDE_API_KEY=
AMPLITUDE_API_KEY=
AMPLITUDE_AI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=denshees-agents
LANGSMITH_TRACING=false

# --- Optional: Logging ---
LOG_LEVEL=INFO
